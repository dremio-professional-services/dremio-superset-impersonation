#!/bin/sh
# Check that a commit is ready to be released as version $1 (the tag vX.Y.Z
# without "v"): CHANGELOG.md and RELEASE.md both name this version.
# Usage: .githooks/check-release X.Y.Z [commit]   (commit defaults to HEAD)
set -eu
version="${1:?usage: check-release X.Y.Z [commit]}"
commit="${2:-HEAD}"
fail=0
show() { git show "$commit:$1"; }

if ! show CHANGELOG.md | grep -Eq "^## \[$version\] - [0-9]{4}-[0-9]{2}-[0-9]{2}$"; then
  echo "check-release: CHANGELOG.md has no section '## [$version] - YYYY-MM-DD'" >&2
  fail=1
fi
if ! show RELEASE.md | head -n 1 | grep -q " $version\$"; then
  echo "check-release: the first line of RELEASE.md does not end with $version" >&2
  fail=1
fi
if show RELEASE.md | grep -q "not released yet"; then
  echo "check-release: RELEASE.md still contains 'not released yet'" >&2
  fail=1
fi
exit "$fail"
