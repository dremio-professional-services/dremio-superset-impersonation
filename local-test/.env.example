# Copy to local-test/.env and fill in. local-test/.env is gitignored; never commit it.
# Quay.io pull access comes from your local `docker login quay.io`.

# Dremio Enterprise license string (single line).
DREMIO_LICENSE=

# Superset SECRET_KEY for the local test stack (also encrypts the proxy PAT in
# the Superset metadata DB). Generate with: openssl rand -base64 42
SUPERSET_SECRET_KEY=
